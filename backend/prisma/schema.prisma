generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String
  role               Role     @default(STUDENT)
  college_id         String
  phone              String?
  profile_photo      String?
  university_roll_no String?
  student_id         String?
  year               String?
  section            String?
  cgpa               String?
  course             String?
  branch             String?
  created_at         DateTime @default(now())

  tasks         Task[]
  attendance    AttendanceRecord[]
  notifications Notification[]
  assignments   Assignment[]
  goals         Goal[]

  @@map("users")
}

model Task {
  id          String     @id @default(uuid())
  user_id     String
  title       String
  description String?
  due_date    DateTime
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(PENDING)
  created_at  DateTime   @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("tasks")
}

model Subject {
  id         String   @id @default(uuid())
  name       String
  college_id String
  course_id  String?
  created_at DateTime @default(now())

  attendance  AttendanceRecord[]
  assignments Assignment[]
  exams       Exam[]

  @@index([college_id])
  @@map("subjects")
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  user_id    String
  subject_id String
  date       DateTime
  status     AttendanceStatus
  created_at DateTime         @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([subject_id])
  @@index([date])
  @@map("attendance_records")
}

model Assignment {
  id          String           @id @default(uuid())
  user_id     String
  subject_id  String
  title       String
  description String?
  due_date    DateTime
  status      AssignmentStatus @default(PENDING)
  created_at  DateTime         @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([due_date])
  @@map("assignments")
}

model Exam {
  id         String   @id @default(uuid())
  subject_id String
  college_id String
  date       DateTime
  time       String
  room       String
  syllabus   String?
  created_at DateTime @default(now())

  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@index([college_id])
  @@index([date])
  @@map("exams")
}

model Notification {
  id         String             @id @default(uuid())
  user_id    String
  source     NotificationSource
  type       NotificationType
  title      String
  message    String
  is_read    Boolean            @default(false)
  created_at DateTime           @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([created_at])
  @@map("notifications")
}

model AcademicCalendarEvent {
  id         String       @id @default(uuid())
  college_id String
  title      String
  type       CalendarType
  date       DateTime
  course_id  String?
  created_at DateTime     @default(now())

  @@index([college_id])
  @@index([date])
  @@map("academic_calendar_events")
}

model Goal {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  category   String
  deadline   DateTime
  created_at DateTime @default(now())

  user     User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  roadmap  RoadmapWeek[]

  @@index([user_id])
  @@map("goals")
}

model RoadmapWeek {
  id          String   @id @default(uuid())
  goal_id     String
  week_number Int
  focus       String
  tasks       String[]
  created_at  DateTime @default(now())

  goal Goal @relation(fields: [goal_id], references: [id], onDelete: Cascade)

  @@index([goal_id])
  @@map("roadmap_weeks")
}

enum Role {
  STUDENT
  ADMIN
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum AssignmentStatus {
  PENDING
  SUBMITTED
}

enum CalendarType {
  EXAM
  PRACTICAL
  PBL
  HOLIDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum NotificationSource {
  ERP
  SYSTEM
}

enum NotificationType {
  EXAM
  HOLIDAY
  EVENT
  ANNOUNCEMENT
  ATTENDANCE
}